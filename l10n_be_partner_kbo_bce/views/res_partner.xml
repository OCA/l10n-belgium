<odoo>
    <record id="view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <!-- Find the existing company_registry field -->
            <xpath expr="//field[@name='company_registry']" position="replace">
                <!-- Show KBO/BCE when Country is Belgium (country_id = 20 typically, or use country_code) -->
                <field
                    name="company_registry"
                    string="KBO/BCE Number"
                    invisible="country_code != 'BE'"
                />

                <!-- Show Company ID for other countries -->
                <field
                    name="company_registry"
                    string="Company ID"
                    invisible="country_code == 'BE'"
                />
            </xpath>
        </field>
    </record>
</odoo>
