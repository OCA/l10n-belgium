<odoo>
    <record id="group_medipim_connector" model="res.groups">
        <field name="name">Medipim Connector</field>
        <field name="category_id" ref="base.module_category_hidden" />
    </record>

    <record model="ir.model.access" id="product_category_medipim_product_manager">
        <field name="name">product.medipim.category Product Manager</field>
        <field name="model_id" ref="model_product_medipim_category" />
        <field name="group_id" ref="product.group_product_manager" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record model="ir.model.access" id="product_category_bfci_public">
        <field name="name">product.medipim.category Public</field>
        <field name="model_id" ref="model_product_medipim_category" />
        <field name="group_id" ref="base.group_public" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="0" />
        <field name="perm_write" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record model="ir.model.access" id="product_category_bfci_portal">
        <field name="name">product.medipim.category Portal</field>
        <field name="model_id" ref="model_product_medipim_category" />
        <field name="group_id" ref="base.group_portal" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="0" />
        <field name="perm_write" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>
</odoo>
