<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_list" model="ir.ui.view">
        <field name="name">account.account.list.import_soda</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="soda_mapping" optional="show" />
            </xpath>
        </field>
    </record>
    <record id="view_account_form" model="ir.ui.view">
        <field name="name">account.account.form.import_soda</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_type']" position="after">
                <field name="soda_mapping" />
            </xpath>
        </field>
    </record>
</odoo>
