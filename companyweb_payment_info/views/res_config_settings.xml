<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.companyweb.payment.info</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="companyweb_base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='companyweb_followup_settings']"
                position="after"
            >
                <block title="Payment Info" name="companyweb_payment_info_settings">
                    <setting
                        id="companyweb_payment_info_enable"
                        help="Automatically send all open customer invoices to Companyweb once per day."
                        company_dependent="1"
                    >
                        <field
                            name="companyweb_payment_info_enable"
                            string="Send Open Invoices to Companyweb"
                        />
                        <small class="text-muted">
                            Shared company data: VAT/registry number, country.<br />
                            Shared per invoice: customer VAT/registry, country, invoice number, date, amount due.
                        </small>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
